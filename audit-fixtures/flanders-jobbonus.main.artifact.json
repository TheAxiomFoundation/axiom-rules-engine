  "program": {
    "module": {
      "summary": "This module encodes the Flemish jobbonus for the 2025 EUROMOD-facing\nannual worker slice. It applies the decree's beneficiary and eligibility\nframework and the Flemish Government implementing order's 2025 wage\nthresholds, degressive amount schedule, work-fraction proration,\nsmall-payment suppression, and fixed 50 euro top-up. It leaves quarterly\nDimona/DMFA reconstruction, frontier-worker annual-income conversion,\nadministrative application/payment procedure, recovery, and objections to\nlater payroll-administration surfaces.",
      "source_verification": {

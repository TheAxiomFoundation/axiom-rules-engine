+def git_dirty(root: Path) -> bool:
+    """Return whether tracked or untracked, non-ignored checkout data changed."""
+
+    status = run_checked(
+        ["git", "-C", str(root), "status", "--porcelain"],
+        label=f"git status check for {root}",
+    ).stdout
+    return bool(status.strip())
+

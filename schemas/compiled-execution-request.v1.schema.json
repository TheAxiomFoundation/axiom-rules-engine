{
  "$defs": {
    "DatasetSpec": {
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InputRecordSpec"
          },
          "type": "array"
        },
        "relations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelationRecordSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "explain",
        "fast"
      ],
      "type": "string"
    },
    "ExecutionQuery": {
      "properties": {
        "assessment_date": {
          "description": "Decision/assessment time: the date the determination is made, as\nopposed to `period`, which is valid time — the benefit period the law\ngoverns. Reserved for the bitemporal version-selection semantics in\n`docs/bitemporal.md`.\n\nToday this field is parsed and validated only: when present it must be\non or after `period.start`, and it has NO effect on evaluation yet.\nVersion selection still considers every version, exactly as if the\nassessment had full knowledge of all enactments.",
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "period": {
          "$ref": "#/$defs/PeriodSpec"
        }
      },
      "required": [
        "entity_id",
        "period",
        "outputs"
      ],
      "type": "object"
    },
    "InputRecordSpec": {
      "properties": {
        "entity": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/IntervalSpec"
        },
        "name": {
          "description": "A request name from the program's input catalog. Derived rules and\nparameters cannot be supplied as dataset inputs; scalar rule overrides\nbelong in the compiled request's `pins`.",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ScalarValueSpec"
        }
      },
      "required": [
        "name",
        "entity",
        "entity_id",
        "interval",
        "value"
      ],
      "type": "object"
    },
    "IntervalSpec": {
      "properties": {
        "end": {
          "format": "date",
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PeriodSpec": {
      "oneOf": [
        {
          "properties": {
            "period_kind": {
              "const": "month",
              "type": "string"
            }
          },
          "required": [
            "period_kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "period_kind": {
              "const": "benefit_week",
              "type": "string"
            }
          },
          "required": [
            "period_kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "period_kind": {
              "const": "tax_year",
              "type": "string"
            }
          },
          "required": [
            "period_kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "period_kind": {
              "const": "custom",
              "type": "string"
            }
          },
          "required": [
            "period_kind",
            "name"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "end": {
          "format": "date",
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "RelationBinding": {
      "description": "Relation tuple validation at the wire-dataset boundary.",
      "oneOf": [
        {
          "enum": [
            "strict"
          ],
          "type": "string"
        },
        {
          "const": "lenient",
          "description": "Retain mismatched tuples without reordering; results may be incomplete.",
          "type": "string"
        }
      ]
    },
    "RelationRecordSpec": {
      "properties": {
        "interval": {
          "$ref": "#/$defs/IntervalSpec"
        },
        "name": {
          "type": "string"
        },
        "tuple": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "tuple",
        "interval"
      ],
      "type": "object"
    },
    "RulePin": {
      "description": "One rule pin: `rule` is the derived rule's name, `value` the literal it\nevaluates to for this request. Judgment rules are not pinnable.",
      "properties": {
        "rule": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ScalarValueSpec"
        }
      },
      "required": [
        "rule",
        "value"
      ],
      "type": "object"
    },
    "ScalarValueSpec": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "decimal",
              "type": "string"
            },
            "value": {
              "description": "Decimal value as a quoted string (arbitrary precision) or a JSON integer; floats are rejected.",
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "date",
              "type": "string"
            },
            "value": {
              "format": "date",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.axiom-foundation.org/rules-engine/compiled-execution-request.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Execute an existing compiled artifact against a dataset. Relation binding defaults to strict; lenient retains mismatched tuples without reordering.",
  "properties": {
    "dataset": {
      "$ref": "#/$defs/DatasetSpec"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "pins": {
      "description": "Caller-supplied rule pins: each named derived rule evaluates to the\ngiven literal for this request, on every date the rule exists. The\nengine rewrites the program before execution — the rule's semantics\nand every version's semantics become the literal, keeping effective\nranges — so all execution modes honour the pin identically and the\ncaller never has to edit an artifact. Naming a rule the program does\nnot contain is an error, not a no-op: a pin that silently fails to\nbind would hand the caller baseline results labelled as a\ncounterfactual.",
      "items": {
        "$ref": "#/$defs/RulePin"
      },
      "type": "array"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/ExecutionQuery"
      },
      "type": "array"
    },
    "relation_binding": {
      "$ref": "#/$defs/RelationBinding",
      "default": "strict",
      "description": "How to handle known relation tuple entity-kind mismatches."
    }
  },
  "required": [
    "mode",
    "dataset",
    "queries"
  ],
  "title": "Axiom compiled execution request",
  "type": "object"
}
